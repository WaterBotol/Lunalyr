<Project Sdk="Microsoft.NET.Sdk">
  <!-- Render engine decisions (pausing, power, pacing, crossfades) as pure logic. No windows, devices or swap chains
       are created here; the engine itself is checked live with tools/EngineHarness. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Lunalyr.Render\Lunalyr.Render.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\**\*.cs" Link="Shared\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
