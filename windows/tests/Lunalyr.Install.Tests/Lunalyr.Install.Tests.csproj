<Project Sdk="Microsoft.NET.Sdk">
  <!-- The installer's logic with fakes only: an in-memory registry, temp install folders, no running copies. Nothing
       here writes the real registry, the real Start menu or the owner's install. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Lunalyr.Install\Lunalyr.Install.csproj" />
  </ItemGroup>
</Project>
