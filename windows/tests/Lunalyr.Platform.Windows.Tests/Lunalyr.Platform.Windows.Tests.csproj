<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests never touch the real settings, network, media sessions or permission prompts: temp folders and fakes only. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Lunalyr.Platform.Windows\Lunalyr.Platform.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Generated covers (make-fixtures.ps1): no artwork from anywhere. -->
    <None Include="Fixtures\Artwork\*.jpg;Fixtures\Artwork\*.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- Made by tools/WallpaperTestMedia: clip.mp4 (its "clip" mode) and turned.jpg (EXIF orientation 6). -->
    <None Include="Fixtures\Wallpaper\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Helpers shared by every test project (fake time). -->
    <Compile Include="..\Shared\**\*.cs" Link="Shared\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
