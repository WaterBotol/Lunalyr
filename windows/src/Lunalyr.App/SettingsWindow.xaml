<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Lunalyr.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Lunalyr Settings">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE708;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="Lunalyr Settings" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <NavigationView Grid.Row="1" x:Name="Nav" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        PaneDisplayMode="Left" OpenPaneLength="220" SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="General" Tag="General" Icon="Home" />
                <NavigationViewItem Content="Lyric style" Tag="Lyric style"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8D2;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Readings" Tag="Readings"><NavigationViewItem.Icon><FontIcon Glyph="&#xF2B7;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Timing" Tag="Timing"><NavigationViewItem.Icon><FontIcon Glyph="&#xE916;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Wallpaper" Tag="Wallpaper"><NavigationViewItem.Icon><FontIcon Glyph="&#xE771;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Covers" Tag="Covers"><NavigationViewItem.Icon><FontIcon Glyph="&#xE93C;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Music players" Tag="Music players"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8D6;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Performance" Tag="Performance"><NavigationViewItem.Icon><FontIcon Glyph="&#xEC4A;" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="AboutItem" Content="About" Tag="About"><NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <ScrollViewer Padding="32,8,32,32">
                <StackPanel Spacing="4" MaxWidth="900" HorizontalAlignment="Stretch">
                    <TextBlock x:Name="PageTitle" Text="About" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,16" />

                    <!-- Every page but About: a placeholder until milestone 5. -->
                    <StackPanel x:Name="PlaceholderPanel" Spacing="4" Visibility="Collapsed">
                        <InfoBar IsOpen="True" Severity="Informational" IsClosable="False" Title="Coming soon"
                                 x:Name="PlaceholderInfo" Message="These settings arrive in a later build." />
                        <TextBlock x:Name="PlaceholderDetail" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- About -->
                    <StackPanel x:Name="AboutPanel" Spacing="4">
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE708;" FontSize="28" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Lunalyr for Windows" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock x:Name="VersionText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Licence" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="© Lunalyr. All rights reserved." Style="{StaticResource BodyTextBlockStyle}" />
                                <Expander Header="Third-party notices" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,8,0,0">
                                    <TextBlock x:Name="NoticesText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </Expander>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Diagnostics" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16" RowSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Now playing" Style="{StaticResource FieldLabel}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="NowPlayingText" Style="{StaticResource FieldValue}" />
                                <TextBlock Grid.Row="1" Text="Player" Style="{StaticResource FieldLabel}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="PlayerText" Style="{StaticResource FieldValue}" />
                                <TextBlock Grid.Row="2" Text="Lyric source" Style="{StaticResource FieldLabel}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SourceText" Style="{StaticResource FieldValue}" />
                                <TextBlock Grid.Row="3" Text="Status" Style="{StaticResource FieldLabel}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="StatusText" Style="{StaticResource FieldValue}" />
                                <TextBlock Grid.Row="4" Text="Wallpaper" Style="{StaticResource FieldLabel}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="WallpaperText" Style="{StaticResource FieldValue}" />
                                <TextBlock Grid.Row="5" Text="Playback commands" Style="{StaticResource FieldLabel}" />
                                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="CommandsText" Style="{StaticResource FieldValue}" />
                                <TextBlock Grid.Row="6" Text="Lyric lookups" Style="{StaticResource FieldLabel}" />
                                <TextBlock Grid.Row="6" Grid.Column="1" x:Name="LookupsText" Style="{StaticResource FieldValue}" />
                                <TextBlock Grid.Row="7" Text="Data folder" Style="{StaticResource FieldLabel}" />
                                <TextBlock Grid.Row="7" Grid.Column="1" x:Name="DataText" Style="{StaticResource FieldValue}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>
