<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Lunalyr.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Lunalyr Settings">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE708;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="Lunalyr Settings" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <NavigationView Grid.Row="1" x:Name="Nav" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        PaneDisplayMode="Left" OpenPaneLength="240" SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItemHeader Content="Look" />
                <NavigationViewItem Content="Lyric style" Tag="Lyric style" AutomationProperties.AutomationId="LyricStyle"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8D2;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Wallpaper" Tag="Wallpaper" AutomationProperties.AutomationId="Wallpaper"><NavigationViewItem.Icon><FontIcon Glyph="&#xE771;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Covers" Tag="Covers" AutomationProperties.AutomationId="Covers"><NavigationViewItem.Icon><FontIcon Glyph="&#xE93C;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItemHeader Content="Words" />
                <NavigationViewItem Content="Timing" Tag="Timing" AutomationProperties.AutomationId="Timing"><NavigationViewItem.Icon><FontIcon Glyph="&#xE916;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Readings" Tag="Readings" AutomationProperties.AutomationId="Readings"><NavigationViewItem.Icon><FontIcon Glyph="&#xF2B7;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItemHeader Content="App" />
                <NavigationViewItem Content="Music players" Tag="Music players" AutomationProperties.AutomationId="MusicPlayers"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8D6;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="General" Tag="General" AutomationProperties.AutomationId="General"><NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Performance" Tag="Performance" AutomationProperties.AutomationId="Performance"><NavigationViewItem.Icon><FontIcon Glyph="&#xEC4A;" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="AboutItem" Content="About" Tag="About" AutomationProperties.AutomationId="About"><NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <ScrollViewer x:Name="Scroller" Padding="36,8,36,36">
                <StackPanel Spacing="4" MaxWidth="1000" HorizontalAlignment="Stretch">
                    <TextBlock x:Name="PageTitle" Text="About" Style="{StaticResource TitleTextBlockStyle}" Margin="0,4,0,20"
                               AutomationProperties.HeadingLevel="Level1" />

                    <!-- Every page but About, built in code (Settings\*.cs). -->
                    <ContentControl x:Name="PageHost" HorizontalContentAlignment="Stretch" IsTabStop="False" />

                    <!-- About -->
                    <StackPanel x:Name="AboutPanel" Spacing="4">
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE708;" FontSize="28" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Lunalyr for Windows" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock Text="Desktop lyrics, in motion." Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock x:Name="VersionText" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Privacy" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
                                <TextBlock Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap"
                                           Text="Readings are worked out on this PC. The lyric services you switch on receive the song’s title, artist and length. Lunalyr only reads what your players share with Windows and never asks for a music account." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Licence" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
                                <TextBlock Text="© Lunalyr. All rights reserved." Style="{StaticResource BodyTextBlockStyle}" />
                                <Expander Header="Third-party notices" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,8,0,0">
                                    <TextBlock x:Name="NoticesText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </Expander>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Diagnostics" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" AutomationProperties.HeadingLevel="Level2" />
                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16" RowSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Now playing" Style="{StaticResource FieldLabel}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="NowPlayingText" Style="{StaticResource FieldValue}" />
                                <TextBlock Grid.Row="1" Text="Player" Style="{StaticResource FieldLabel}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="PlayerText" Style="{StaticResource FieldValue}" />
                                <TextBlock Grid.Row="2" Text="Lyric source" Style="{StaticResource FieldLabel}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SourceText" Style="{StaticResource FieldValue}" />
                                <TextBlock Grid.Row="3" Text="Status" Style="{StaticResource FieldLabel}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="StatusText" Style="{StaticResource FieldValue}" />
                                <TextBlock Grid.Row="4" Text="Wallpaper" Style="{StaticResource FieldLabel}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="WallpaperText" Style="{StaticResource FieldValue}" />
                                <TextBlock Grid.Row="5" Text="Playback commands" Style="{StaticResource FieldLabel}" />
                                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="CommandsText" Style="{StaticResource FieldValue}" />
                                <TextBlock Grid.Row="6" Text="Lyric lookups" Style="{StaticResource FieldLabel}" />
                                <TextBlock Grid.Row="6" Grid.Column="1" x:Name="LookupsText" Style="{StaticResource FieldValue}" />
                                <TextBlock Grid.Row="7" Text="Data folder" Style="{StaticResource FieldLabel}" />
                                <TextBlock Grid.Row="7" Grid.Column="1" x:Name="DataText" Style="{StaticResource FieldValue}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>
