<Project Sdk="Microsoft.NET.Sdk">
  <!-- Platform-independent logic ported from the Mac app: lyric parsing, ranking, timing faults, word timing and
       motion maths, colour extraction, scrub maths, queue rules. No Windows APIs here, so it tests anywhere. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Lunalyr.Core</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
</Project>
