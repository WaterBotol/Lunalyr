<Project Sdk="Microsoft.NET.Sdk">
  <!-- The desktop renderer: Direct3D 11 + Direct2D + DirectWrite through Vortice. Layers (backgrounds, lyric
       compositions) draw into a D2D device context once per frame on the render thread. No XAML here. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Lunalyr.Render</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Vortice.Direct2D1" />
    <PackageReference Include="Vortice.Direct3D11" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Lunalyr.Core\Lunalyr.Core.csproj" />
    <!-- Desktop attach, monitors and power/session signals live with the other Windows services. -->
    <ProjectReference Include="..\Lunalyr.Platform.Windows\Lunalyr.Platform.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Lunalyr.Render.Compositions.Tests" />
  </ItemGroup>
  <!-- The GPU effects' and line patterns' HLSL, compiled with fxc at build time and embedded (see the file). -->
  <Import Project="Backgrounds\Gpu\Shaders.targets" />
</Project>
