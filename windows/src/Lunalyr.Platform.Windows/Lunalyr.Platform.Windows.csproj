<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows services with no UI: now playing (GSMTC), settings store, logging, desktop attach, monitors, power. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Lunalyr.Platform</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Lunalyr.Core\Lunalyr.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The Japanese dictionary (IPAdic), built by tools/JapaneseDictionaryBuilder: see docs/READINGS-WINDOWS.md. -->
    <EmbeddedResource Include="Readings\Data\ipadic.lunadic.br" LogicalName="Lunalyr.Platform.Readings.Data.ipadic.lunadic.br" />
  </ItemGroup>
</Project>
