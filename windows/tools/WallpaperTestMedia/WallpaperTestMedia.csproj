<Project Sdk="Microsoft.NET.Sdk">
  <!-- Makes invented test media for the imported-wallpaper checks: a short silent H.264 gradient clip (Media
       Foundation's own encoder) and test pictures (PNG, JPEG, and a JPEG turned by its EXIF orientation). It never
       reads anyone's files. Not part of the app or the solution. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
</Project>
