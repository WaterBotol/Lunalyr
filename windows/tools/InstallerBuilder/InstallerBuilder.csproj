<Project Sdk="Microsoft.NET.Sdk">
  <!-- Build-time tool: makes "Lunalyr Setup.exe" with the app's zip appended, writes the update feed, and makes or uses
       the update-signing key. Never run by the tests; never publishes anything. See docs/PACKAGING.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Lunalyr.Install\Lunalyr.Install.csproj" />
  </ItemGroup>
</Project>
