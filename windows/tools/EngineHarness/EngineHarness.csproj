<Project Sdk="Microsoft.NET.Sdk">
  <!-- Manual/visual check of the render engine: solid colour + debug text on every monitor (behind the icons) for N
       seconds, then stats. Plays nothing and touches no media session. Not part of the app or the solution.
       Build:  dotnet publish tools/EngineHarness -c Release   (Native AOT) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- SharpGen.Runtime (under Vortice) warns about its reflection path for COM callbacks implemented in C#
         (TypeDataStorage.GetSourceVtblFromReflection). The engine implements no COM callbacks, and the spike ran
         the same stack under Native AOT, so only that roll-up warning is silenced. -->
    <NoWarn>$(NoWarn);IL2104</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Lunalyr.Render\Lunalyr.Render.csproj" />
  </ItemGroup>
</Project>
