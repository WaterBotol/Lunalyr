<Project Sdk="Microsoft.NET.Sdk">
  <!-- Renders every visualiser scene offscreen from recorded synthetic sound (silence, a beat, a sweep, loud noise) to
       PNGs, checks the photosensitivity limiter against loud noise, and measures GPU cost per scene on a chosen adapter.
       Never captures or plays sound. Not part of the app or the solution. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Lunalyr.Render\Lunalyr.Render.csproj" />
    <ProjectReference Include="..\..\src\Lunalyr.Shell\Lunalyr.Shell.csproj" />
  </ItemGroup>
</Project>
