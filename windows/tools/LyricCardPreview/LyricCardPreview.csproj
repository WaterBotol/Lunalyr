<Project Sdk="Microsoft.NET.Sdk">
  <!-- Makes lyric cards of the demo songs offscreen with the app's own exporter (PNG stills, MP4 and GIF frames, sound
       mixes from synthetic tones) for looking at them, into docs/previews/lyric-cards. Never plays anything. Not part
       of the app or the solution. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Lunalyr.Shell\Lunalyr.Shell.csproj" />
  </ItemGroup>
</Project>
