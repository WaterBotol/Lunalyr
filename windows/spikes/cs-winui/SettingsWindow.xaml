<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LunalyrSpike.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Lunalyr Settings">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8D6;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Text="Lunalyr Settings" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <NavigationView Grid.Row="1" x:Name="Nav" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        PaneDisplayMode="Left" OpenPaneLength="220" SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="General" Tag="General" Icon="Home" />
                <NavigationViewItem Content="Lyric style" Tag="Lyric style"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8D2;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Readings" Tag="Readings"><NavigationViewItem.Icon><FontIcon Glyph="&#xF2B7;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Timing" Tag="Timing"><NavigationViewItem.Icon><FontIcon Glyph="&#xE916;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Wallpaper" Tag="Wallpaper" IsSelected="True"><NavigationViewItem.Icon><FontIcon Glyph="&#xE771;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Covers" Tag="Covers"><NavigationViewItem.Icon><FontIcon Glyph="&#xE93C;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Music players" Tag="Music players"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8D6;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="Performance" Tag="Performance"><NavigationViewItem.Icon><FontIcon Glyph="&#xEC4A;" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="About" Tag="About"><NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <ScrollViewer Padding="32,8,32,32">
                <StackPanel Spacing="4" MaxWidth="900" HorizontalAlignment="Stretch">
                    <TextBlock x:Name="PageTitle" Text="Wallpaper" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,16" />
                    <InfoBar IsOpen="True" Severity="Informational" IsClosable="False" Title="Spike build"
                             Message="This window checks the native look only. Nothing here is wired up yet." Margin="0,0,0,12" />

                    <TextBlock Text="Lyrics" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,4" />
                    <Border Style="{StaticResource Card}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8D2;" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Composition" /><TextBlock Text="How the lyric lines are laid out on the desktop" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                            <ComboBox Grid.Column="2" SelectedIndex="0" MinWidth="200" VerticalAlignment="Center">
                                <x:String>Match the music</x:String><x:String>Editorial</x:String><x:String>Spoken</x:String><x:String>Scattered</x:String><x:String>Constellation</x:String><x:String>Echo</x:String><x:String>Cascade</x:String>
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7B3;" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Reveal" /><TextBlock Text="How each word appears as it's sung" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                            <ComboBox Grid.Column="2" SelectedIndex="0" MinWidth="200" VerticalAlignment="Center">
                                <x:String>Soft focus</x:String><x:String>Float up</x:String><x:String>Pop</x:String><x:String>Orbit</x:String><x:String>Glide</x:String>
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8E9;" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Lyric size" /><TextBlock Text="Relative to the height of each display" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                            <Slider Grid.Column="2" Minimum="4" Maximum="12" Value="7.5" StepFrequency="0.5" Width="200" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <TextBlock Text="Background" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Background" />
                            <RadioButtons SelectedIndex="0" MaxColumns="3">
                                <x:String>Album colours</x:String><x:String>Motion artwork</x:String><x:String>Visualiser</x:String><x:String>Music video</x:String><x:String>Image or video</x:String><x:String>Colour only</x:String>
                            </RadioButtons>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7F4;" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Show on every display" /><TextBlock Text="Otherwise only on the main display" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                            <ToggleSwitch Grid.Column="2" IsOn="True" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE83F;" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Pause on battery saver" /><TextBlock Text="Shows a still frame until you're plugged in" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                            <ToggleSwitch Grid.Column="2" IsOn="True" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
                        <Button Content="Align video" Style="{StaticResource AccentButtonStyle}" />
                        <Button Content="Reset to defaults" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>
